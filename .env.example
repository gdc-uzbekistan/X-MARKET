# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ADMIN_INITIAL_PASSWORD: Initial administrator passcode stored only on the server.
# Configure this in the Secrets panel (e.g., x-market.) before first admin login,
# or complete the one-time First-Run Admin Setup form in the Admin Portal.
ADMIN_INITIAL_PASSWORD=

# SESSION_SECRET: Optional HMAC signing secret for user/admin session tokens.
# Falls back to an in-memory cryptographically random secret if unset.
SESSION_SECRET=

# SMS_WEBHOOK_URL & SMS_API_KEY: Optional external SMS gateway for live phone OTP delivery.
SMS_WEBHOOK_URL=
SMS_API_KEY=
